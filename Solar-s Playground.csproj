    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>SolarsPlayground</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ExtraLINQ" Version="2.0.0" />
    <PackageReference Include="fennecs" Version="0.6.12" />
    <PackageReference Include="Fluid-HTN" Version="0.0.0" />
    <PackageReference Include="Humanizer" Version="3.0.10" />
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="Mapster" Version="10.0.11" />
    <PackageReference Include="SharpResults" Version="0.4.4" />
  </ItemGroup>
</Project>